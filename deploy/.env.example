# ════════════════════════════════════════════════════════════════
# ISPmanager 生产部署环境变量模板
# 用法：
#   1) 一键安装（推荐）：传入站点域名后执行 install.sh
#        sudo SITE_DOMAIN=www.example.net CERTBOT_EMAIL=ops@example.net bash install.sh
#      脚本会自动生成密钥并写入本目录 .env
#   2) 分步安装：cp .env.example .env 后按需修改，再执行各脚本
#
# URL 规则：
#   combined（默认，同一台机器）
#     客户门户     https://SITE_DOMAIN/
#     管理端       https://SITE_DOMAIN/manager
#     Django Admin https://SITE_DOMAIN/admin/
#     API / WS     https://SITE_DOMAIN/api/  与  /ws/
#   split（管理端与门户分两台机器）
#     本机只提供管理端、Django Admin 和管理 API
#     门户页面装在另一台服务器，经 ISPweb 网关访问下面的门户 API 端口
# ════════════════════════════════════════════════════════════════

# ── 基础路径 ─────────────────────────────────────────────────────
# 同时包含 ISPmanager 与 ISPweb 的上级目录。留空则自动探测。
# split 时本机可以只有 ISPmanager。
PROJECT_ROOT=

# combined：门户和管理端装在本机。split：门户装在另一台服务器。
DEPLOY_LAYOUT=combined

APP_USER=ispmanager
APP_GROUP=ispmanager

# ── 域名与 HTTPS ─────────────────────────────────────────────────
SITE_DOMAIN=www.example.com
# 可选：额外 server_name（空格分隔），例如裸域 example.com
SITE_ALIASES=
# 管理端 SPA 路径，须与前端生产构建 base 一致
ADMIN_BASE_PATH=/manager
# 旧变量：combined 时脚本会把二者规范为与 SITE_DOMAIN 相同。
# split 时 PORTAL_DOMAIN 必须是另一台 ISPweb 的域名，不要写成管理端域名。
ADMIN_DOMAIN=
PORTAL_DOMAIN=

# ── 分机部署（仅 DEPLOY_LAYOUT=split）────────────────────────
# 门户服务器出口地址，逗号分隔。只有这些地址能连接门户 API 端口。
PORTAL_API_ALLOW_CIDRS=
# 与 ISPweb 的 PORTAL_API_SECRET 必须相同，至少 32 位。留空时 install.sh 会生成。
PORTAL_API_SECRET=
# 门户 API 监听端口。不要占用 80/443。ISPweb 的 API 地址写成 https://管理端域名:该端口
PORTAL_API_PORT=8443
# 门户浏览器地址。留空时按 https://PORTAL_DOMAIN 生成，用于支付完成后跳回门户。
PORTAL_PUBLIC_ORIGIN=
PORTAL_PUBLIC_PORT=443
# Let's Encrypt 到期通知邮箱（SSL_MODE=letsencrypt 时建议填写）
CERTBOT_EMAIL=admin@example.com
# auto        公网 DNS 指向出口 IP 则 Let's Encrypt，否则自签
# letsencrypt 强制 Let's Encrypt（路由器须转发 80 到本机 LISTEN_HTTP_PORT）
# selfsigned  自签（内网 / DNS 未就绪 / 只用 IP 访问）
# skip        仅 HTTP
SSL_MODE=auto

# ── 内网 NAT / 端口映射 ──────────────────────────────────────────
# 本机在路由器后面时保持 1。auto 表示有 RFC1918 地址则视为 NAT
BEHIND_NAT=auto
# 出口公网 IP（探测失败或多线出口不一致时手填，供 DNS 对照与自签 SAN）
PUBLIC_IP=
# nginx 实际监听（本机端口）。路由器 80/443 应转到这两个端口
LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443
# 浏览器看到的端口（面板映射 30090、或公网 8443 时填写）
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
# 1：HTTP 一律 301 跳到 HTTPS，只允许 HTTPS 访问（默认）
# auto：Let's Encrypt 后跳转；NAT 自签则不跳转（路由器只转发了 80、还没转发 443 时用）
SSL_HTTP_REDIRECT=1

# ── Django 生产配置 ──────────────────────────────────────────────
# 占位符会在 install.sh 中自动替换为随机值
DJANGO_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
PAYMENT_CONFIG_ENCRYPTION_KEY=CHANGE_ME_TO_AN_INDEPENDENT_RANDOM_STRING
# 支付回跳基础地址；须指向管理端 SPA，脚本写成 https://站点/manager
PAYMENT_FRONTEND_URL=https://www.example.com/manager
DJANGO_DEBUG=False
DJANGO_PRODUCTION=True
# 逗号分隔。install.sh 会按域名/本机 IP 自动补全
DJANGO_ALLOWED_HOSTS=www.example.com,127.0.0.1,localhost
# 浏览器访问端口：标准 HTTPS 用 443。经面板/Docker 映射时填实际端口（如 30090）
PUBLIC_PORT=443
ADMIN_PUBLIC_PORT=443
PORTAL_PUBLIC_PORT=443
# 额外映射端口（逗号分隔），用于 CSRF/CORS。例如 30090
# CSRF_PUBLIC_PORTS=30090
# 留空则由 Django / 部署脚本按域名、别名、ALLOWED_HOSTS 自动生成 http/https Origin
# 其他前端要跨域调用 /api/ 时，把它的完整来源加进 DJANGO_CORS_ALLOWED_ORIGINS（逗号分隔），
# 例如 https://app.example.net,https://app.example.net:8443。脚本只会追加，不会删掉你写的值。
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_CORS_ALLOWED_ORIGINS=
# nginx 终止 TLS 并反代到 gunicorn 时必须为 True（生产代码也会强制开启）
DJANGO_SECURE_PROXY_SSL_HEADER=True

DJANGO_STATIC_ROOT=
DJANGO_MEDIA_ROOT=

# 系统维护：业务数据备份 / 在线升级（默认写在 MEDIA_ROOT 下）
# SYSTEM_BACKUP_DIR=
# SYSTEM_UPGRADE_DIR=
# SYSTEM_BACKUP_MAX_UPLOAD=2147483648
# SYSTEM_UPGRADE_MAX_UPLOAD=524288000
# SYSTEM_UPGRADE_RESTART=True
# 网页升级以 APP_USER 运行，须配合 /etc/sudoers.d/ispmanager-web-upgrade
# SYSTEM_UPGRADE_RESTART_CMD=sudo -n /bin/systemctl restart ispmanager.service
# ISPMANAGER_VERSION_FILE=

# ── 数据库（MySQL）─────────────────────────────────────────────
DB_NAME=ISPmanager
DB_USER=ispmanager
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_HOST=127.0.0.1
DB_PORT=3306
# 仅 02-setup-database.sh 使用；Ubuntu 默认 auth_socket 可留空
MYSQL_ROOT_PASSWORD=

# ── 应用服务（gunicorn + uvicorn ASGI）─────────────────────────
APP_BIND=127.0.0.1:8000
GUNICORN_WORKERS=3

# ── Channels（WebSSH / VNC 多 worker 建议 Redis）────────────────
# CHANNEL_LAYER_BACKEND=redis
# CHANNEL_REDIS_URL=redis://127.0.0.1:6379/0
CHANNEL_LAYER_BACKEND=
CHANNEL_REDIS_URL=

# ── Django 超级管理员（留空密码则 install.sh 自动生成）───────────
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=admin@example.com

# ── 邮件 ────────────────────────────────────────────────────────
DJANGO_EMAIL_HOST=localhost
DJANGO_EMAIL_PORT=25
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=False
DJANGO_EMAIL_USE_SSL=False
DJANGO_DEFAULT_FROM_EMAIL="ISP Manager <noreply@example.com>"
