[Unit]
Description=ISPmanager periodic maintenance (paid orders, holds, refunds, scheduled changes)
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=oneshot
User=__APP_USER__
Group=__APP_GROUP__
WorkingDirectory=__BACKEND_DIR__

EnvironmentFile=-__RUNTIME_ENV_FILE__
Environment=PYTHONUNBUFFERED=1

ExecStart=-__VENV_DIR__/bin/python manage.py fulfill_paid_orders
ExecStart=-__VENV_DIR__/bin/python manage.py release_expired_reservations
ExecStart=-__VENV_DIR__/bin/python manage.py expire_payment_transactions
ExecStart=-__VENV_DIR__/bin/python manage.py process_eligible_refunds
ExecStart=-__VENV_DIR__/bin/python manage.py process_scheduled_changes

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
